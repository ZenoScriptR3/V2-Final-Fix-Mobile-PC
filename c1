local function addBoxEsp(player)
	if player == LocalPlayer then return end
	local function onChar(char)
		if not boxEspActive then return end
		if boxHighlights[player] then boxHighlights[player]:Destroy() end
		local h = Instance.new("Highlight")
		h.Name                = "BoxESP"
		h.FillTransparency    = 1
		h.OutlineColor        = THEME.Accent
		h.OutlineTransparency = 0
		h.Adornee             = char
		h.Parent              = ScreenGui
		boxHighlights[player] = h
	end
	player.CharacterAdded:Connect(onChar)
	if player.Character then onChar(player.Character) end
end

local function removeBoxEsp()
	for _, h in pairs(boxHighlights) do
		if h then h:Destroy() end
	end
	table.clear(boxHighlights)
end

EspButton.MouseButton1Click:Connect(function()
	boxEspActive = not boxEspActive
	if boxEspActive then
		EspButton.Text             = "ESP: ON"
		EspButton.BackgroundColor3 = THEME.Accent
		EspButton.TextColor3       = THEME.Text
		for _, p in ipairs(Players:GetPlayers()) do addBoxEsp(p) end
	else
		EspButton.Text             = "ESP: OFF"
		EspButton.BackgroundColor3 = THEME.Row
		EspButton.TextColor3       = THEME.TextDim
		removeBoxEsp()
	end
end)

local function addNameEsp(player)
	if player == LocalPlayer then return end
	local function onChar(char)
		if not nameEspActive then return end
		if nameGuis[player] then nameGuis[player]:Destroy() end
		local head = char:WaitForChild("Head", 5)
		if not head then return end
		local bbg = Instance.new("BillboardGui")
		bbg.Size           = UDim2.new(0, 200, 0, 40)
		bbg.AlwaysOnTop    = true
		bbg.ExtentsOffset  = Vector3.new(0, 2.5, 0)
		bbg.Adornee        = head
		local label = Instance.new("TextLabel")
		label.Size                   = UDim2.new(1, 0, 1, 0)
		label.BackgroundTransparency = 1
		label.Text                   = player.DisplayName .. " (@" .. player.Name .. ")"
		label.TextColor3             = THEME.Accent
		label.Font                   = Enum.Font.GothamBold
		label.TextSize               = 13
		label.TextStrokeTransparency = 0
		label.TextStrokeColor3       = Color3.fromRGB(0, 0, 0)
		label.Parent                 = bbg
		bbg.Parent                   = ScreenGui
		nameGuis[player]             = bbg
	end
	player.CharacterAdded:Connect(onChar)
	if player.Character then task.spawn(onChar, player.Character) end
end

local function removeNameEsp()
	for _, g in pairs(nameGuis) do
		if g then g:Destroy() end
	end
	table.clear(nameGuis)
end

NameEspButton.MouseButton1Click:Connect(function()
	nameEspActive = not nameEspActive
	if nameEspActive then
		NameEspButton.Text             = "Name ESP: ON"
		NameEspButton.BackgroundColor3 = THEME.Accent
