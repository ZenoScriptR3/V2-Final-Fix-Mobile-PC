local camX, camY = 0, 0
local camPos = Vector3.new(0, 0, 0)
local isRightMouseDown = false
local oldWalkSpeed = 16
local cameraController = nil
do
	local ok, module = pcall(function()
		return require(LocalPlayer.PlayerScripts:WaitForChild("PlayerModule"))
	end)
	if ok and module then
		local ok2, cams = pcall(function() return module:GetCameras() end)
		if ok2 then cameraController = cams end
	end
end

FreecamButton.MouseButton1Click:Connect(function()
	freecamActive = not freecamActive
	local camera = workspace.CurrentCamera
	if freecamActive then
		FreecamButton.Text             = "Freecam: ON"
		FreecamButton.BackgroundColor3 = THEME.Accent
		FreecamButton.TextColor3       = THEME.Text

		if cameraController then pcall(function() cameraController:Disable() end) end

		camera.CameraType = Enum.CameraType.Scriptable
		camera.CameraSubject = nil
		camX = math.floor(math.deg(math.atan2(-camera.CFrame.LookVector.X, -camera.CFrame.LookVector.Z)))
		camY = math.floor(math.deg(math.asin(math.clamp(camera.CFrame.LookVector.Y, -1, 1))))
		camPos = camera.CFrame.Position
		if LocalPlayer.Character then
			local h = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
			if h then oldWalkSpeed = h.WalkSpeed; h.WalkSpeed = 0 end
		end
	else
		FreecamButton.Text             = "Freecam: OFF"
		FreecamButton.BackgroundColor3 = THEME.Row
		FreecamButton.TextColor3       = THEME.TextDim

		UserInputService.MouseBehavior = Enum.MouseBehavior.Default
		camera.CameraType = Enum.CameraType.Custom
		if LocalPlayer.Character then
			local h = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
			if h then h.WalkSpeed = oldWalkSpeed; camera.CameraSubject = h end
		end
		if cameraController then pcall(function() cameraController:Enable() end) end
	end
end)

UserInputService.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton2 then
		isRightMouseDown = true
		if freecamActive then
			UserInputService.MouseBehavior = Enum.MouseBehavior.LockCurrentPosition
		end
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton2 then
		isRightMouseDown = false
		if freecamActive then
			UserInputService.MouseBehavior = Enum.MouseBehavior.Default
		end
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if freecamActive and isRightMouseDown and input.UserInputType == Enum.UserInputType.MouseMovement then
		camX = camX - input.Delta.X * 0.4
		camY = math.clamp(camY - input.Delta.Y * 0.4, -80, 80)
	end
end)

RunService.RenderStepped:Connect(function()
	if freecamActive then
		local camera = workspace.CurrentCamera
		camera.CameraType = Enum.CameraType.Scriptable
		if isRightMouseDown then
			UserInputService.MouseBehavior = Enum.MouseBehavior.LockCurrentPosition
		else
			UserInputService.MouseBehavior = Enum.MouseBehavior.Default
		end
		local rotationCFrame = CFrame.Angles(0, math.rad(camX), 0) * CFrame.Angles(math.rad(camY), 0, 0)
		local moveVector = Vector3.zero
		if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveVector = moveVector + rotationCFrame.LookVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveVector = moveVector - rotationCFrame.LookVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveVector = moveVector - rotationCFrame.RightVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveVector = moveVector + rotationCFrame.RightVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.E) then moveVector = moveVector + Vector3.new(0, 1, 0) end
		if UserInputService:IsKeyDown(Enum.KeyCode.Q) then moveVector = moveVector - Vector3.new(0, 1, 0) end
		if moveVector.Magnitude > 0 then
			camPos = camPos + moveVector.Unit * 1.5
		end
		camera.CFrame = CFrame.new(camPos) * rotationCFrame
	end
end)

