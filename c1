local function addRainbow(parent, thickness)
	local stroke = Instance.new("UIStroke")
	stroke.Thickness       = thickness
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Color           = Color3.fromRGB(255, 0, 0)
	stroke.Parent          = parent
	task.spawn(function()
		local hue = 0
		while stroke.Parent do
			hue = (hue + 0.004) % 1
			pcall(function() stroke.Color = Color3.fromHSV(hue, 1, 1) end)
			RunService.RenderStepped:Wait()
		end
	end)
	return stroke
end

local function addCorner(parent, radius)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius)
	c.Parent = parent
	return c
end

local function makeButton(parent, text, size, position, bg, fg)
	local btn = Instance.new("TextButton")
	btn.Size               = size
	btn.Position           = position
	btn.BackgroundColor3   = bg
	btn.BorderSizePixel    = 0
	btn.Text               = text
	btn.TextColor3         = fg
	btn.Font               = Enum.Font.GothamBold
	btn.TextSize           = 13
	btn.AutoButtonColor    = false
	btn.Parent             = parent
	addCorner(btn, 8)
	return btn
end

local function hoverTween(btn, normal, hover)
	btn.MouseEnter:Connect(function()
		TweenService:Create(btn, TweenInfo.new(0.15), { BackgroundColor3 = hover }):Play()
	end)
	btn.MouseLeave:Connect(function()
		TweenService:Create(btn, TweenInfo.new(0.15), { BackgroundColor3 = normal }):Play()
	end)
end

local function makeDraggable(frame)
	local dragging, dragInput, dragStart, startPos
	frame.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = frame.Position
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then dragging = false end
			end)
		end
	end)
	frame.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch then dragInput = input end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if input == dragInput and dragging then
			local delta = input.Position - dragStart
			frame.Position = UDim2.new(
				startPos.X.Scale, startPos.X.Offset + delta.X,
				startPos.Y.Scale, startPos.Y.Offset + delta.Y
			)
		end
	end)
end

