		rowStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		rowStroke.Parent          = row

		local nameBtn = Instance.new("TextButton")
		nameBtn.Size                   = UDim2.new(1, 0, 1, 0)
		nameBtn.BackgroundTransparency = 1
		nameBtn.Font                   = Enum.Font.Gotham
		nameBtn.TextSize               = 12
		nameBtn.TextColor3             = isSelf and THEME.Accent or THEME.Text
		nameBtn.TextXAlignment         = Enum.TextXAlignment.Left
		nameBtn.Text                   = "  " .. p.Name .. (isSelf and "  (you)" or "")
		nameBtn.AutoButtonColor        = false
		nameBtn.Parent                 = row

		if not isSelf then
			nameBtn.MouseEnter:Connect(function()
				TweenService:Create(nameBtn, TweenInfo.new(0.15), { BackgroundTransparency = 0.85, BackgroundColor3 = THEME.Accent }):Play()
