-- ── Right Shift toggle ───────────────────────────────
UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if not gameProcessed and input.KeyCode == Enum.KeyCode.RightShift then
		local anyVisible = MainFrame.Visible or ListPanel.Visible
		if anyVisible then
			MainFrame.Visible = false
			ListPanel.Visible = false
		else
			MainFrame.Visible = true
			ListPanel.Visible = true
		end
		if not MainFrame.Visible and not ListPanel.Visible then
			clearHighlight()
		end
	end
end)

-- ── Players added/removed ────────────────────────────
Players.PlayerAdded:Connect(function(p)
	if boxEspActive  then addBoxEsp(p)  end
	if nameEspActive then addNameEsp(p) end
	refreshServerList()
end)

Players.PlayerRemoving:Connect(function(p)
	if boxHighlights[p] then boxHighlights[p]:Destroy(); boxHighlights[p] = nil end
	if nameGuis[p]      then nameGuis[p]:Destroy();      nameGuis[p]      = nil end
	refreshServerList()
end)

-- ── Fling All loop ───────────────────────────────────
task.spawn(function()
	while true do
		if isActive then
			for _, player in ipairs(Players:GetPlayers()) do
				if not isActive then break end
				if player ~= LocalPlayer
					and not whitelistedPlayers[player.Name:lower()]
					and player.Character
					and player.Character:FindFirstChild("HumanoidRootPart") then
					local char = LocalPlayer.Character
					local hum  = char and char:FindFirstChildOfClass("Humanoid")
					if hum and hum.Health > 0 then
						flingPlayer(player)
						task.wait(delayBetweenPlayers)
					end
				end
			end
		end
		task.wait(0.5)
	end
end)

-- ── Loop Fling handler ───────────────────────────────
task.spawn(function()
	while true do
		local hasTarget = false
		for name, _ in pairs(loopFlingPlayers) do
			local player = nil
			for _, p in ipairs(Players:GetPlayers()) do
				if p.Name:lower() == name then player = p; break end
			end
			if player and player ~= LocalPlayer
				and not whitelistedPlayers[player.Name:lower()]
				and player.Character
				and player.Character:FindFirstChild("HumanoidRootPart") then
				local char = LocalPlayer.Character
				local hum  = char and char:FindFirstChildOfClass("Humanoid")
				if hum and hum.Health > 0 then
					hasTarget = true
					flingPlayer(player)
					task.wait(delayBetweenPlayers)
				end
			end
		end
		if not hasTarget then task.wait(0.5) end
	end
end)

-- ── Auto noclip ──────────────────────────────────────
RunService.Stepped:Connect(function()
	local character = LocalPlayer.Character
	if character then
		for _, part in ipairs(character:GetDescendants()) do
			if part:IsA("BasePart") and part.CanCollide then
				part.CanCollide = false
			end
		end
	end
end)

