		for _, p in ipairs(Players:GetPlayers()) do addNameEsp(p) end
	else
		NameEspButton.Text             = "Name ESP: OFF"
		NameEspButton.BackgroundColor3 = THEME.Row
		NameEspButton.TextColor3       = THEME.TextDim
		removeNameEsp()
	end
end)

