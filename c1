local function refreshServerList()
	for _, child in ipairs(ServerListScroll:GetChildren()) do
		if not child:IsA("UIListLayout") and not child:IsA("UIPadding") then
			child:Destroy()
		end
	end

	local sorted = {}
	for _, p in ipairs(Players:GetPlayers()) do table.insert(sorted, p) end
	table.sort(sorted, function(a, b) return a.Name:lower() < b.Name:lower() end)

	CountLabel.Text = "Players: " .. #sorted

	for _, p in ipairs(sorted) do
		local isSelf = (p == LocalPlayer)

		local row = Instance.new("Frame")
		row.Size             = UDim2.new(1, -8, 0, 30)
		row.BackgroundColor3 = THEME.Row
		row.BorderSizePixel  = 0
